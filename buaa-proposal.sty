% 使用标准 thebibliography/list/bibitem 机制，调整标题和左顶格样式。
\renewenvironment{thebibliography}[1]
  {\section{\refname}%
   \list{\@biblabel{\@arabic\c@enumiv}}%
     {\settowidth\labelwidth{\@biblabel{#1}}%
      \setlength{\leftmargin}{0pt}%
      \setlength{\itemindent}{\labelwidth}\addtolength{\itemindent}{\labelsep}%
      \setlength{\itemsep}{0pt}\setlength{\parsep}{0pt}%
      \def\makelabel##1{##1\hfil}\usecounter{enumiv}\let\p@enumiv\@empty\renewcommand{\theenumiv}{\@arabic\c@enumiv}}%
   \sloppy\clubpenalty4000\widowpenalty4000\sfcode`\.=1000\relax}
  {\def\@noitemerr{\@latex@warning{Empty bibliography}}\endlist}
% 旧版引用命令复用标准引用，文献条目放在 thebibliography 环境内。
\let\ReportCitation\cite
\newcommand{\ReferenceItem}[2]{\bibitem{#1}#2}
\newcommand{\ReferenceNote}[1]{\par\noindent #1\par}

% 共用目录行引擎：正文标题保留其运行字体，点线与页码继承原 TOC 样式。
\newcommand{\buaa@tocline}[3]{%
  \par\begingroup\buaa@usestyle{toc-#1}\parindent=0pt
    \def\numberline##1{\makebox[\buaa@value{toc/#1/number-width}bp][l]{##1}}%
    \leftskip=\dimexpr\buaa@value{toc/#1/indent}bp+\buaa@value{toc/#1/number-width}bp\relax
    \rightskip=\dimexpr\linewidth-\buaa@value{toc/width}bp+\buaa@value{toc/page-width}bp\relax
    \parfillskip=-\buaa@value{toc/page-width}bp
    \noindent\hspace*{-\buaa@value{toc/#1/number-width}bp}#2\nobreak
    \hspace{\buaa@value{toc/gap}bp}%
    {\buaa@value{toc/#1/page-font}\leaders\hbox{.}\hfill}%
    \nobreak\hspace{\buaa@value{toc/gap}bp}%
    \makebox[\buaa@value{toc/page-width}bp][r]{\buaa@value{toc/#1/page-font}#3}\par\endgroup}
\renewcommand*\l@section[2]{\ifnum\value{tocdepth}>0\relax\buaa@tocline{section}{#1}{#2}\fi}
\renewcommand*\l@subsection[2]{\ifnum\value{tocdepth}>1\relax\buaa@tocline{subsection}{#1}{#2}\fi}
\renewcommand*\l@subsubsection[2]{%
  \ifnum\value{tocdepth}>2\relax\buaa@tocline{subsubsection}{#1}{#2}\fi}
