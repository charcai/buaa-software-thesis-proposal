% 公共写作接口见 README。内部命令统一使用 buaa@ 前缀，
% expl3 临时变量使用 l__buaa_ 前缀，均由样式文件内部维护。

% ===== 原稿字体：每个字体只解析一次；名称别名只指同一字体，不允许换字体 =====
% 顺序：项目文件 -> 已安装的原字体（中英文名）-> Word 自带的同一字体文件。
\ExplSyntaxOn
\msg_new:nnn {buaa-proposal} {missing-font}
  {Required~original~DOC~font~'#1'~was~not~found.\iow_newline:
   Install~that~font~or~provide~its~exact~file~in~the~project.\iow_newline:
   Compilation~stopped;~font~substitution~is~disabled.}
% 参数依次为内部字体标识、系统英文名、系统中文名（可空）、
% 项目字体文件名、Word 内置文件名、fontspec 选项。
% 解析后的文件名和选项独立保存在 buaa@resolvedfont... 中。
\cs_new_protected:Npn \buaa@requirefont #1#2#3#4#5#6
  {
    \tl_set:Nn \l_tmpa_tl {#4}
    \tl_set:Nn \l_tmpb_tl {#6}
    \file_if_exist:nF {#4}
      {
        \clist_map_inline:nn {#2,#3}
          {\IfFontExistsTF{##1}
            {\tl_set:Nn \l_tmpa_tl {##1}\clist_map_break:}{}}
        \tl_if_eq:NnT \l_tmpa_tl {#4}
          {
            \file_if_exist:nTF {/Applications/Microsoft~Word.app/Contents/Resources/DFonts/#5}
              {\tl_put_left:Nn \l_tmpb_tl
                 {Path={/Applications/Microsoft~Word.app/Contents/Resources/DFonts/},}
               \tl_set:Nn \l_tmpa_tl {#5}}
              {\msg_fatal:nnn {buaa-proposal}{missing-font}{#2}}
          }
      }
    \cs_gset:cpx {buaa@resolvedfont@#1} {\exp_not:V \l_tmpa_tl}
    \cs_gset:cpx {buaa@resolvedfontoptions@#1} {\exp_not:V \l_tmpb_tl}
  }
% 参数依次为 fontspec 加载命令、新字体命令（setmainfont 等使用空值）、
% 前面注册的内部字体标识。
\cs_new_protected:Npn \buaa@loadfont #1#2#3
  {\use:x {\exp_not:N #1 \exp_not:n {#2}
    [\use:c {buaa@resolvedfontoptions@#3}]{\use:c {buaa@resolvedfont@#3}}}}
\NewDocumentCommand \buaa@datepart {m m}
  {\exp_args:No \tl_if_blank:nTF {#1} {#2} {#1\hspace{\buaa@value{date/part-gap}bp}#2}}
\ExplSyntaxOff
