% 长填写项按原字号折行，后续栏位与日期随之下移。
\newbox\buaa@coverbox
\newdimen\buaa@covershift
\newdimen\buaa@coverextra
% 可选参数为填写区横坐标和宽度，必选参数为首行基线、横线基线、
% 标签和填写内容。坐标与宽度均以 bp 为单位。
% 本命令在 MakeCover 的局部分组内累计填写栏的额外高度。
\NewDocumentCommand{\buaa@coverfield}{O{\buaa@value{cover/value-x}} O{\buaa@value{cover/value-width}} m m m m}{%
  \buaa@usestyle{cover-entry}%
  \setbox\buaa@coverbox=\hbox{#6}%
  \ifdim\wd\buaa@coverbox>#2bp
    \setbox\buaa@coverbox=\vtop{\hsize=#2bp\parindent=0pt
      \raggedright\strut #6\strut\par}%
  \else
    \setbox\buaa@coverbox=\hbox to #2bp{\hfil\strut #6\strut\hfil}%
  \fi
  \buaa@coverextra=\dimexpr\dp\buaa@coverbox-\dp\strutbox\relax
  \put(\LenToUnit{161.28bp},-\LenToUnit{\dimexpr#3bp+\buaa@covershift\relax}){{\buaa@usestyle{cover-label}#5}}%
  \put(\LenToUnit{#1bp},-\LenToUnit{\dimexpr#3bp+\buaa@covershift\relax}){\box\buaa@coverbox}%
  \advance\buaa@covershift by \buaa@coverextra
  \put(\LenToUnit{#1bp},-\LenToUnit{\dimexpr#4bp+\buaa@covershift\relax}){%
    \rule{#2bp}{\buaa@value{cover/rule-thickness}bp}}%
}
